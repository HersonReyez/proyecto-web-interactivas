# Destino del proxy de Vite para la API y las cookies de Sanctum.
LARAVEL_API_URL=http://127.0.0.1:8000
# Origen público de Laravel para las imágenes si frontend y backend se publican en dominios distintos.
# En desarrollo local puede permanecer vacío: Vite reenvía /storage al backend.
VITE_STORAGE_URL=
